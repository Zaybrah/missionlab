      "item": "Cell Phone",
      "facePlayer": true,
      "extraction": "open",
      "message": "Phone secured. The way out is open."
    },
    {
      "id": 7,
      "name": "Way out by itself",
      "when": "time",
      "delay": 1200,
      "facePlayer": true,
      "message": "Twenty minutes: the way out is open."
    }
  ],
